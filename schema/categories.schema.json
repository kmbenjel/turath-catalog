{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kmbenjel/turath-catalog/schema/categories.schema.json",
  "title": "turath-catalog categories",
  "description": "The 40 subject categories (those of al-Maktaba al-Shamila) with English names.",
  "type": "object",
  "properties": {
    "category_ar": {
      "description": "Category in Arabic.",
      "type": "string"
    },
    "category_en": {
      "description": "Category in English.",
      "type": "string"
    },
    "n_works": {
      "description": "Works in the category.",
      "type": "integer",
      "minimum": 0
    },
    "n_editions": {
      "description": "Editions in the category.",
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "category_ar",
    "category_en",
    "n_works",
    "n_editions"
  ],
  "additionalProperties": false
}
